From aec0be75ba3e50036a863deb5b0cdfef1f5abd30 Mon Sep 17 00:00:00 2001
From: Dan Ballard <dballard@jminsure.com>
Date: Wed, 4 Jun 2025 15:20:54 -0400
Subject: [PATCH] Add support for assume account with externalId StringLike
 condition

---
 .../lib/stacks/operations-stack.ts            | 26 +++++++++++++++----
 .../@aws-accelerator/config/lib/iam-config.ts |  2 ++
 .../config/lib/models/iam-config.ts           | 10 +++++++
 .../config/lib/schemas/iam-config.json        |  8 ++++++
 4 files changed, 41 insertions(+), 5 deletions(-)

diff --git a/source/packages/@aws-accelerator/accelerator/lib/stacks/operations-stack.ts b/source/packages/@aws-accelerator/accelerator/lib/stacks/operations-stack.ts
index a26db8032..dffcded3f 100644
--- a/source/packages/@aws-accelerator/accelerator/lib/stacks/operations-stack.ts
+++ b/source/packages/@aws-accelerator/accelerator/lib/stacks/operations-stack.ts
@@ -413,14 +413,30 @@ export class OperationsStack extends AcceleratorStack {
             throw new Error(`The principal defined in arn ${assumedByItem.principal} is too long`);
           }
           if (accountIdRegex.test(assumedByItem.principal)) {
-            principals.push(new cdk.aws_iam.AccountPrincipal(assumedByItem.principal));
+
+            let tempPrincipal = new cdk.aws_iam.AccountPrincipal(assumedByItem.principal);
+            if (assumedByItem.externalId && assumedByItem.conditionKey) {
+              tempPrincipal = new cdk.aws_iam.PrincipalWithConditions(tempPrincipal, {});
+              tempPrincipal.addCondition(assumedByItem.conditionKey, {'sts:ExternalId': assumedByItem.externalId});
+            }
+
+            principals.push(tempPrincipal);
           } else if (accountArnRegex.test(assumedByItem.principal)) {
             const accountId = accountArnRegex.exec(assumedByItem.principal);
-            principals.push(new cdk.aws_iam.AccountPrincipal(accountId![1]));
+            let tempPrincipal = new cdk.aws_iam.AccountPrincipal(new cdk.aws_iam.AccountPrincipal(accountId![1]));
+            if (assumedByItem.externalId && assumedByItem.conditionKey) {
+              tempPrincipal = new cdk.aws_iam.PrincipalWithConditions(tempPrincipal, {});
+              tempPrincipal.addCondition(assumedByItem.conditionKey, {'sts:ExternalId': assumedByItem.externalId});
+            }
+            principals.push(tempPrincipal);
           } else {
-            principals.push(
-              new cdk.aws_iam.AccountPrincipal(this.props.accountsConfig.getAccountId(assumedByItem.principal)),
-            );
+            let tempPrincipal = new cdk.aws_iam.AccountPrincipal(this.props.accountsConfig.getAccountId(assumedByItem.principal));
+
+            if (assumedByItem.externalId && assumedByItem.conditionKey) {
+              tempPrincipal = new cdk.aws_iam.PrincipalWithConditions(tempPrincipal, {});
+              tempPrincipal.addCondition(assumedByItem.conditionKey, {'sts:ExternalId': assumedByItem.externalId});
+            }
+            principals.push(tempPrincipal);
           }
           break;
         case 'provider':
diff --git a/source/packages/@aws-accelerator/config/lib/iam-config.ts b/source/packages/@aws-accelerator/config/lib/iam-config.ts
index f74cd9620..8e220c413 100644
--- a/source/packages/@aws-accelerator/config/lib/iam-config.ts
+++ b/source/packages/@aws-accelerator/config/lib/iam-config.ts
@@ -138,6 +138,8 @@ export class GroupSetConfig implements i.IGroupSetConfig {
 export class AssumedByConfig implements i.IAssumedByConfig {
   readonly principal: string = '';
   readonly type!: t.AssumedByType;
+  readonly conditionKey: string | undefined = undefined;
+  readonly externalId: string | undefined = undefined;
 }
 
 export class RoleConfig implements i.IRoleConfig {
diff --git a/source/packages/@aws-accelerator/config/lib/models/iam-config.ts b/source/packages/@aws-accelerator/config/lib/models/iam-config.ts
index bbef50808..332b170a6 100644
--- a/source/packages/@aws-accelerator/config/lib/models/iam-config.ts
+++ b/source/packages/@aws-accelerator/config/lib/models/iam-config.ts
@@ -460,6 +460,16 @@ export interface IAssumedByConfig {
    * Type of IAM principal type like service, account, principalArn or provider, which can assume this role.
    */
   readonly principal?: t.NonEmptyString;
+
+  /**
+   * Type of condition to use e.g. StringEquals or StringLike.
+   */
+  readonly conditionKey?: t.NonEmptyString;
+
+  /**
+   * The externalId to add to the condition.
+   */
+  readonly externalId?: t.NonEmptyString;
 }
 
 /**
diff --git a/source/packages/@aws-accelerator/config/lib/schemas/iam-config.json b/source/packages/@aws-accelerator/config/lib/schemas/iam-config.json
index e707e4a3f..5f70505e0 100644
--- a/source/packages/@aws-accelerator/config/lib/schemas/iam-config.json
+++ b/source/packages/@aws-accelerator/config/lib/schemas/iam-config.json
@@ -195,6 +195,14 @@
       "additionalProperties": false,
       "description": "AssumedBy configuration\n\nService principal:",
       "properties": {
+        "externalId": {
+          "$ref": "#/definitions/NonEmptyString",
+          "description": "Type of condition to use for the external ID (if specified)"
+        },
+        "conditionKey": {
+          "$ref": "#/definitions/NonEmptyString",
+          "description": "Type of condition to use for the external ID (if specified)"
+        },
         "principal": {
           "$ref": "#/definitions/NonEmptyString",
           "description": "Type of IAM principal type like service, account, principalArn or provider, which can assume this role."
-- 
2.50.1 (Apple Git-155)

